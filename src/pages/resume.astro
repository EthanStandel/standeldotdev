---
import Email from "@fortawesome/fontawesome-free/svgs/solid/envelope.svg?raw";
import Pin from "@fortawesome/fontawesome-free/svgs/solid/map-pin.svg?raw";
import Github from "@fortawesome/fontawesome-free/svgs/brands/github.svg?raw";
import Globe from "@fortawesome/fontawesome-free/svgs/solid/globe.svg?raw";
import LinkedIn from "@fortawesome/fontawesome-free/svgs/brands/linkedin.svg?raw";
import Phone from "@fortawesome/fontawesome-free/svgs/solid/phone.svg?raw";
import Check from "@fortawesome/fontawesome-free/svgs/solid/check.svg?raw";

const icons = {
  email: Email,
  phone: Phone,
  pin: Pin,
  globe: Globe,
  github: Github,
  linkedin: LinkedIn,
};

type Link = { text: string; href: string };
/** Plain text, or a sequence of text and links rendered inline. */
type RichText = string | (string | Link)[];
type ContactItem = { icon: keyof typeof icons; text: string; href?: string };
type HistoryItem = {
  role: string;
  org: string;
  dates: string;
  bullets?: RichText[];
};
type Section = {
  heading: string;
  items?: HistoryItem[];
  bullets?: RichText[];
};

const resume: {
  title: string;
  name: string;
  jobTitle: string;
  summary: string;
  skills: string[];
  contact: ContactItem[][];
  sections: Section[];
  footer: RichText;
} = {
  title: "Ethan Standel - Resume",
  name: "Ethan Standel",
  jobTitle: "Senior Software Engineer · Fullstack Web & Mobile",
  summary:
    "Fullstack engineer with 9+ years building web and mobile applications, supporting design systems, and engineering backend services. I'm drawn to demanding requirements in performance, accessibility, internationalization, theming, scale, and data management. I care about developer experience and maintainable codebases. As the industry evolves, I am continuously refining how I use AI coding agents to ship faster with higher quality.",
  skills: [
    // What I build
    "Fullstack web apps",
    "Mobile apps",
    "AI-powered tools",
    // Frontend craft
    "Design systems",
    "Component libraries",
    "Animation & interaction",
    // Backend & data
    "APIs & backend services",
    "Database architecture",
    "Auth & SSO",
    // Integrations & modernization
    "CMS integration",
    "Ad integrations",
    "Legacy migrations",
    // Communication
    "Technical writing",
    "Tech talks",
  ],
  contact: [
    [
      {
        icon: "email",
        text: "ethan@standel.dev",
        href: "mailto:ethan@standel.dev",
      },
      { icon: "phone", text: "(207) 210-1127", href: "tel:2072101127" },
      { icon: "pin", text: "Saco, Maine" },
    ],
    [
      { icon: "globe", text: "standel.dev", href: "https://www.standel.dev" },
      {
        icon: "github",
        text: "github.com/EthanStandel",
        href: "https://github.com/EthanStandel",
      },
      {
        icon: "linkedin",
        text: "linkedin.com/in/ethan-standel",
        href: "https://www.linkedin.com/in/ethan-standel/",
      },
    ],
  ],
  sections: [
    {
      heading: "Career experience",
      items: [
        {
          role: "Software Engineer to Senior Software Engineer",
          org: "DEPT®",
          dates: "May 2021 to present",
          bullets: [
            "Embedded with multiple major tech clients, adapting to their proprietary version control, code review processes, developer tooling, and custom internal frameworks. Shipped production code with traditional coding IDEs as well as internal agentic IDEs.",
            "Built performance-optimized, animation-heavy marketing sites with analytics integrations for multiple clients, including serving as tech lead for a major entertainment & tech brand (React + Motion).",
            "Implemented a responsive ad layout schema integrated with Google Ad Manager (GAM) for a Vue/Nuxt app.",
            "Led multiple legacy migrations onto modern technical stacks (React & Next.js), reintegrating existing functionality as well as introducing new features like SSO, account management, and CMS integrations.",
            "Architected and implemented design and component systems using Module Federation & microfrontends for clients in B2B environments.",
            "Built customer-facing apps for multiple clients, including an AI-powered document processing tool that generates synopses and analysis, and a location-based portal with custom Google Maps integrations.",
            "Architected the digitization of a legacy paper application process as a fullstack web app with complete & auditable change history in a PostgreSQL database on a Node.js backend.",
            "Supported clients in transitioning from JavaScript to TypeScript for application stability.",
            "Contributing actively to company engineering culture with internal tech talks and project retrospective reviews as well as articles on the public blog.",
          ],
        },
        {
          role: "Software Engineer I to Software Engineer II",
          org: "WEX",
          dates: "May 2017 to May 2021",
          bullets: [
            "Developed Ionic, Cordova, and Angular mobile apps with location services and live notifications, backed by Java + Spring microservices.",
            "Built an Angular + Material ecommerce site integrating first- and third-party APIs via a BFF microservice.",
            "Helped architect an incremental migration path off a legacy application and integrated a new SSO system.",
            "Supported the transition to a cloud-native CI/CD pipeline, as well as the conversion from on-prem deployments to AWS.",
          ],
        },
      ],
    },
    {
      heading: "Education",
      items: [
        {
          role: "Bachelor of Science in Computer Science",
          org: "University of Southern Maine",
          dates: "Sept 2013 to May 2017",
        },
      ],
    },
    {
      heading: "Open source & side projects",
      bullets: [
        [
          {
            text: "@deepsignal/react",
            href: "https://www.npmjs.com/package/@deepsignal/react",
          },
          ": React state management built on ",
          {
            text: "@preact/signals",
            href: "https://www.npmjs.com/package/@preact/signals",
          },
          ", using the ",
          {
            text: "signal primitive to bypass the VDOM",
            href: "https://engineering.dept.global/why-i-built-a-new-state-management-library",
          },
          " for fine-grained updates.",
        ],
        [
          { text: "cakeelizabeth.com", href: "https://cakeelizabeth.com/" },
          ": Next.js site for my wife's bakery.",
        ],
      ],
    },
  ],
  footer: [
    "This resume is written in HTML & CSS. See it live at ",
    { text: "standel.dev/resume", href: "https://www.standel.dev/resume" },
    " or view the source at ",
    {
      text: "standel.dev/resume-src",
      href: "https://www.standel.dev/resume-src",
    },
    ".",
  ],
};

const parts = (value: RichText) =>
  typeof value === "string" ? [value] : value;
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="darkreader-lock" />
    <title>{resume.title}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@200;400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="container">
      <div class="content">
        <div class="intro">
          <h1 class="name">{resume.name}</h1>
          <h2 class="title">{resume.jobTitle}</h2>
          <p class="about-me">{resume.summary}</p>
          <p class="skills">
            {
              resume.skills.map((skill, i) => (
                <>
                  {i > 0 && " · "}
                  <span>{skill}</span>
                </>
              ))
            }
          </p>
        </div>

        <div class="contact">
          {
            resume.contact.map((column) => (
              <ul>
                {column.map(({ icon, text, href }) => (
                  <li>
                    <Fragment set:html={icons[icon]} />
                    <p>{href ? <a href={href}>{text}</a> : text}</p>
                  </li>
                ))}
              </ul>
            ))
          }
        </div>

        {
          resume.sections.map((section) => (
            <section>
              <h3>{section.heading}</h3>
              {section.items?.map((item) => (
                <div class="history-item">
                  <h4>{item.role}</h4>
                  <h5>{`${item.org} · ${item.dates}`}</h5>
                  {item.bullets && (
                    <ul>
                      {item.bullets.map((bullet) => (
                        <li>
                          {parts(bullet).map((part) =>
                            typeof part === "string" ? (
                              part
                            ) : (
                              <a href={part.href}>{part.text}</a>
                            ),
                          )}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
              {section.bullets && (
                <ul>
                  {section.bullets.map((bullet) => (
                    <li>
                      {parts(bullet).map((part) =>
                        typeof part === "string" ? (
                          part
                        ) : (
                          <a href={part.href}>{part.text}</a>
                        ),
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }

        <div class="about-resume">
          <p>
            {
              parts(resume.footer).map((part) =>
                typeof part === "string" ? (
                  part
                ) : (
                  <a href={part.href}>{part.text}</a>
                ),
              )
            }
          </p>
        </div>
      </div>
    </div>
    <style
      lang="scss"
      is:global
      define:vars={{
        check: `url("data:image/svg+xml,${encodeURIComponent(Check)}")`,
      }}
    >
      @page {
        size: letter;
        margin: 0;
      }

      html,
      body {
        --link: #0066cc;
        --dark: #1f1f1f;
        --light: #4d4d4d;
        --lighter: #686868;
        --rule: #d9d9d9;
        @media print {
          --link: var(--dark);
        }
        font-family: "Poppins", sans-serif;
        color: var(--dark);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: black;
        margin: 0;
        min-height: 100vh;
        width: 100%;

        .container {
          width: 8.5in;
          height: 11in;
          background: white;
          display: flex;
          flex-direction: column;
        }

        .content {
          margin: 0.5in;
          display: flex;
          flex-direction: column;
          flex-grow: 1;

          a {
            color: var(--link);
            text-decoration: none;
          }

          .intro {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;

            h1,
            h2,
            p {
              margin: 0;
              line-height: 1.15;
            }

            .name {
              font-size: 22pt;
              line-height: 1;
            }

            .title {
              font-size: 13pt;
              color: var(--light);
            }

            .about-me {
              font-size: 9pt;
              text-align: justify;
            }

            .skills {
              font-size: 8.5pt;
              color: var(--light);
              margin-top: 0.4em;
              line-height: 1.35;

              span {
                white-space: nowrap;
              }
            }
          }

          .contact {
            margin: 0.5em 0;
            padding: 0.35em 0;
            border-top: 1px solid var(--rule);
            border-bottom: 1px solid var(--rule);
            display: flex;
            ul {
              width: 50%;
              list-style-type: none;
              margin: 0;
              padding: 0;
              li {
                display: flex;
                align-items: center;
                gap: 0.5em;
              }
            }
            p {
              margin: 0;
              line-height: 1.75;
              font-size: 10pt;
            }
            svg {
              height: 16px !important;
              width: 16px !important;
              fill: var(--light) !important;
            }
          }

          section {
            margin-bottom: 0.35em;

            h3,
            h4,
            h5 {
              margin: 0;
              line-height: 1.5;
            }
            h3 {
              font-size: 12.5pt;
            }
            h4,
            h5 {
              line-height: 1.4;
            }
            h4 {
              font-size: 10.5pt;
              color: var(--light);
            }
            h5 {
              font-size: 9pt;
              color: var(--lighter);
            }

            .history-item:not(:last-child) {
              margin-bottom: 0.25em;
            }

            ul {
              margin: 0.15em 0 0;
              padding-inline-start: 18px;
              font-size: 9.5pt;
              line-height: 1.25;
              text-align: justify;

              li {
                margin-top: 0.12em;
                list-style: none;
                position: relative;

                &::before {
                  content: "";
                  position: absolute;
                  left: -16px;
                  top: 0.22em;
                  width: 0.85em;
                  height: 0.85em;
                  background-color: var(--dark);
                  mask: var(--check) center / contain no-repeat;
                  -webkit-print-color-adjust: exact;
                  print-color-adjust: exact;
                }
              }
            }
          }

          .about-resume {
            font-size: 8pt;
            display: flex;
            align-items: flex-end;
            justify-content: center;
            text-align: center;
            flex-grow: 1;

            > * {
              max-width: 70%;
            }
            p {
              margin: 0;
              line-height: 1.15;
            }
          }
        }
      }
    </style>
  </body>
</html>
